NODE_ENV=development
HOST=0.0.0.0
PORT=4001
PUBLIC_URL=http://127.0.0.1:4001
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# MongoDB Atlas connection string. Keep this out of GitHub.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_TIMEOUT_MS=10000
MONGO_ALLOW_SNAPSHOT=true
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_DOMAIN=
SQL_DUMP=./upload/taxsathi2.sql
UPLOAD_MAX_MB=15

# OTP provider (optional for local development; required for real OTP flows).
FAST2SMS_API_KEY=
FAST2SMS_URL=https://www.fast2sms.com/dev/bulkV2
FAST2SMS_ROUTE=dlt
FAST2SMS_SENDER_ID=SECAST
FAST2SMS_MESSAGE_ID=204251
FAST2SMS_SCHEDULE_TIME=

# Optional integrations.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_NUMBER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
