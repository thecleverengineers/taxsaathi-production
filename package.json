{
  "name": "taxsaathi-mern",
  "version": "1.0.0",
  "private": true,
  "description": "Tax Saathi MERN migration with legacy MariaDB import support",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "node --watch server/index.mjs",
    "client:dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/index.mjs",
    "snapshot": "node server/scripts/migrate-sql-to-mongo.mjs --snapshot",
    "migrate": "node server/scripts/migrate-sql-to-mongo.mjs",
    "migrate:replace": "node server/scripts/migrate-sql-to-mongo.mjs --replace",
    "migrate:files": "node server/scripts/migrate-files-to-gridfs.mjs",
    "cron:reminders": "node server/scripts/workflow-reminders.mjs",
    "check": "node server/scripts/check.mjs",
    "test": "node --test server/tests/*.test.mjs",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart taxsaathi-mern --update-env",
    "pm2:stop": "pm2 stop taxsaathi-mern",
    "pm2:logs": "pm2 logs taxsaathi-mern"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mongodb": "^6.20.0",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
